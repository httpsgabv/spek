{
	"permissions": {
		"deny": [
			"Read(**/.env)",
			"Read(**/.env.local)",
			"Read(**/.env.development)",
			"Read(**/.env.staging)",
			"Read(**/.env.production)",
			"Read(**/*.pem)",
			"Read(**/*.key)",
			"Read(**/secrets/**)",
			"Bash(cat .env:*)",
			"Bash(git push --force:*)",
			"Bash(git push -f:*)",
			"Bash(git reset --hard:*)",
			"Bash(rm -rf:*)"
		]
	}
}
