{
	"name": "@spek/api",
	"version": "0.1.0",
	"private": true,
	"type": "commonjs",
	"scripts": {
		"dev": "nest start --watch",
		"build": "nest build",
		"start": "node --env-file-if-exists=.env dist/main.js",
		"test": "vitest run",
		"test:unit": "vitest run --project unit",
		"test:integration": "vitest run --project integration",
		"check-types": "tsc --noEmit",
		"deps:check": "depcruise src",
		"openapi:export": "nest build && node dist/exportar-openapi.js"
	},
	"dependencies": {
		"@fastify/static": "^10.1.2",
		"@nestjs/common": "^11.2.12",
		"@nestjs/core": "^11.2.12",
		"@nestjs/platform-fastify": "^11.2.12",
		"@nestjs/swagger": "^11.4.8",
		"fastify": "^5.12.8",
		"nestjs-zod": "^5.6.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@nestjs/cli": "^11.0.24",
		"@swc/core": "^1.16.22",
		"@types/node": "^24.19.4",
		"@types/supertest": "^7.2.1",
		"dependency-cruiser": "^18.9.0",
		"supertest": "^7.3.2",
		"typescript": "~6.0.3",
		"unplugin-swc": "^2.0.0",
		"vitest": "^5.1.2",
		"@spek/config": "workspace:*"
	}
}
