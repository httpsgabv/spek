{
	"name": "spek",
	"private": true,
	"packageManager": "pnpm@10.28.2",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"test": "turbo run test",
		"lint": "biome check .",
		"format": "biome check --write .",
		"check-types": "turbo run check-types",
		"contracts:generate": "pnpm --filter @spek/api openapi:export && pnpm --filter @spek/contracts generate",
		"db:up": "docker compose up -d",
		"db:down": "docker compose down"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.9",
		"turbo": "^2.11.13",
		"typescript": "~6.0.3",
		"@spek/config": "workspace:*"
	}
}
