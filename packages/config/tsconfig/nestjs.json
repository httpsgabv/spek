{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "./base.json",
	"compilerOptions": {
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"lib": ["ES2023"],
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"noUncheckedIndexedAccess": false,
		"sourceMap": true,
		"types": ["node"]
	}
}
